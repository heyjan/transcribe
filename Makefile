# Video -> bilingual transcript pipeline. `make` alone lists the targets.
#
# Every option is a variable, e.g.
#   make local   SRC="/mnt/c/Users/<you>/Downloads/Some Course"
#   make youtube URL='https://www.youtube.com/watch?v=9IErvdJJHs4'
#   make german  OUT=out/youtube

PY          := .venv/bin/python
OUT         ?= out
YOUTUBE_OUT ?= out/youtube
LANGS       ?= en,de
SOURCE_LANG ?= en
CAPTION_LANG ?= en
DE          ?= voxtral
MAX_SPEND   ?= 1.00
LIMIT       ?=
FORCE       ?=
COLLECTION  ?=
ARGS        ?=

OPTS   = $(if $(LIMIT),--limit $(LIMIT)) $(if $(FORCE),--force) \
         $(if $(COLLECTION),--collection "$(COLLECTION)") $(ARGS)
COMMON = --languages $(LANGS) --source-lang $(SOURCE_LANG) \
         --translator $(DE) --max-spend $(MAX_SPEND) $(OPTS)
URLS   = $(foreach u,$(URL),'$(u)')

.DEFAULT_GOAL := help
.PHONY: help setup uv-check model check lock update-ytdlp local youtube youtube-captions \
        german german-dry render

help:
	@echo "Transcription"
	@echo "  make local SRC=<file-or-dir>     local videos  -> $(OUT)/        (Granite EN + Voxtral DE)"
	@echo "  make youtube URL=<url...>        YouTube video(s)/playlist -> $(YOUTUBE_OUT)/"
	@echo "  make youtube-captions URL=<url>  YouTube captions only, no GPU (CAPTION_LANG=$(CAPTION_LANG))"
	@echo ""
	@echo "Post-processing (OUT=<dir>, default $(OUT))"
	@echo "  make german [OUT=...]            give older Granite-German transcripts Voxtral German"
	@echo "  make german-dry [OUT=...]        price that without sending anything"
	@echo "  make render [OUT=...]            rebuild HTML/SRT/TXT from JSON, no GPU"
	@echo ""
	@echo "Setup"
	@echo "  make setup                       .venv from requirements.lock.txt + model download + check"
	@echo "  make model                       download the pinned Granite weights (~4.6 GB, no token)"
	@echo "  make check                       confirm torch sees the GPU"
	@echo "  make lock                        rewrite requirements.lock.txt from the current .venv"
	@echo "  make update-ytdlp                upgrade yt-dlp when YouTube breaks it"
	@echo ""
	@echo "Options: LANGS=$(LANGS) SOURCE_LANG=$(SOURCE_LANG) LIMIT=N FORCE=1"
	@echo "         DE=granite (free, local, worse German)  MAX_SPEND=$(MAX_SPEND) (USD)"
	@echo "         COLLECTION='Index title' ARGS='--target 20 ...'"

# --- setup ------------------------------------------------------------------

# uv carries its own CA roots; older releases still trust the emSign CAs
# (eMudhra key incident, 2026-10-20).
UV_MIN := 0.13.4

setup: uv-check
	uv venv --python 3.12
	VIRTUAL_ENV=.venv uv pip install -r requirements.lock.txt
	@$(MAKE) --no-print-directory model
	@$(MAKE) --no-print-directory check

uv-check:
	@v=$$(uv --version | awk '{print $$2}'); \
	if [ "$$(printf '%s\n' $(UV_MIN) $$v | sort -V | head -1)" != "$(UV_MIN)" ]; then \
	  echo "uv $$v is too old (need >= $(UV_MIN)): run 'uv self update'"; exit 1; fi; \
	echo "uv $$v ok"

model:
	$(PY) -m pipeline.models

lock:
	{ echo "# Full tested environment (Linux x86_64, Python 3.12, CUDA 13 wheels)."; \
	  echo "# Generated by \`make lock\`; do not edit by hand."; \
	  VIRTUAL_ENV=.venv uv pip freeze; } > requirements.lock.txt

check:
	$(PY) -c "import torch; print(torch.cuda.get_arch_list()[-1], torch.cuda.is_available())"

update-ytdlp:
	VIRTUAL_ENV=.venv uv pip install -U "yt-dlp[default]"
	@$(PY) -m yt_dlp --version

# --- transcription ----------------------------------------------------------

local:
	$(if $(SRC),,$(error SRC is required: make local SRC="/mnt/c/.../course-dir"))
	$(PY) transcribe.py "$(SRC)" -o "$(OUT)" $(COMMON)

youtube:
	$(if $(URL),,$(error URL is required: make youtube URL='https://www.youtube.com/watch?v=...'))
	$(PY) transcribe.py $(URLS) -o "$(YOUTUBE_OUT)" --captions never $(COMMON)

youtube-captions:
	$(if $(URL),,$(error URL is required: make youtube-captions URL='https://www.youtube.com/watch?v=...'))
	$(PY) transcribe.py $(URLS) -o "$(YOUTUBE_OUT)" --captions only \
	  --languages $(CAPTION_LANG) --source-lang $(CAPTION_LANG) $(OPTS)

# --- post-processing --------------------------------------------------------

german:
	$(PY) voxtral_de.py "$(OUT)" $(if $(FORCE),--force)

german-dry:
	$(PY) voxtral_de.py "$(OUT)" --dry-run $(if $(FORCE),--force)

render:
	$(PY) transcribe.py --render-only -o "$(OUT)" $(if $(COLLECTION),--collection "$(COLLECTION)")
